---
interface Props {
  title: string;
  description?: string;
  category?: string;
  href?: string;
  image?: string;
}

const {
  title,
  description,
  category,
  href = "#",
  image,
} = Astro.props;
---

<a href={href} class="card">
  {image && (
    <div class="card-image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}

  <div class="card-content">
    {category && (
      <div class="category">{category}</div>
    )}

    <h3>{title}</h3>

    {description && (
      <p>{description}</p>
    )}

    <span class="card-link">
      Explore
      <span aria-hidden="true">→</span>
    </span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    min-height: 280px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--background);
    text-decoration: none;
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 102, 255, 0.35);
    box-shadow: 0 16px 40px rgba(11, 15, 20, 0.08);
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px;
  }

  .category {
    margin-bottom: 12px;
    color: var(--royal-blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--black);
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  p {
    margin: 12px 0 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding-top: 24px;
    color: var(--royal-blue);
    font-size: 13px;
    font-weight: 650;
  }

  .card-link span {
    transition: transform 180ms ease;
  }

  .card:hover .card-link span {
    transform: translateX(4px);
  }
</style>