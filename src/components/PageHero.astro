---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const {
  eyebrow,
  title,
  description,
} = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}

    <h1>{title}</h1>

    {description && (
      <p class="description">{description}</p>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding: 96px 0 72px;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(0, 140, 255, 0.08),
        transparent 28%
      ),
      var(--background);
  }

  .eyebrow {
    margin-bottom: 18px;
    color: var(--royal-blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    color: var(--black);
    font-size: clamp(42px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .description {
    max-width: 680px;
    margin: 24px 0 0;
    color: var(--text-muted);
    font-size: 18px;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .page-hero {
      padding: 72px 0 56px;
    }

    .description {
      font-size: 16px;
    }
  }
</style>